# Insertion sort for up to 256 signed i32 numbers.
GENE main i32
ARRAY values 256
READ values r0
LOAD r1 1
LOAD r7 1
LABEL outer _
MOV r6 r1
LT r6 r0
JZ r6 done
AGET r2 values,r1
MOV r3 r1
LABEL shift _
JZ r3 place
MOV r4 r3
SUB r4 r7
AGET r5 values,r4
MOV r6 r2
LT r6 r5
JZ r6 place
ASET values r3,r5
MOV r3 r4
JMP shift _
LABEL place _
ASET values r3,r2
ADD r1 r7
JMP outer _
LABEL done _
WRITE values r0
RET r0 _
END _ _
