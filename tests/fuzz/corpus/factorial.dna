# Factorial: 0..12 have exact i32 results; larger values wrap modulo 2^32.
# Negative input returns 0. Excessive work stops at the shared step limit.
# codons run examples/factorial.dna 5 -> 120
GENE main i32/1
LOAD r1 0
MOV r2 r0
LT r2 r1
JNZ r2 invalid
LOAD r1 1
LOAD r2 1
LABEL loop _
JZ r0 done
MUL r1 r0
SUB r0 r2
JMP loop _
LABEL done _
RET r1 _
LABEL invalid _
RET r1 _
END _ _
