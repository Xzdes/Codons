GENE main i32
ARRAY in 100
ARRAY out 100
READ in r1
MOV r2 r1
DIV r2 2
LOAD r3 0
LOAD r4 0
LABEL loop _
MOV r5 r3
LT r5 r2
JZ r5 tail
AGET r6 in,r3
ASET out r4,r6
ADD r4 1
MOV r7 r2
ADD r7 r3
AGET r6 in,r7
ASET out r4,r6
ADD r4 1
ADD r3 1
JMP loop _
LABEL tail _
MOV r7 r2
ADD r7 r3
MOV r5 r7
LT r5 r1
JZ r5 done
AGET r6 in,r7
ASET out r4,r6
ADD r4 1
ADD r3 1
JMP tail _
LABEL done _
WRITE out r1
RET r1 _
END _ _
