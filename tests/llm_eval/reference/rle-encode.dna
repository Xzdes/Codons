GENE main i32
ARRAY in 100
ARRAY out 200
READ in r1
LOAD r2 0
LOAD r3 0
LABEL outer _
MOV r4 r2
LT r4 r1
JZ r4 done
AGET r5 in,r2
LOAD r6 0
LABEL inner _
MOV r4 r2
LT r4 r1
JZ r4 emit
AGET r7 in,r2
EQ r7 r5
JZ r7 emit
ADD r6 1
ADD r2 1
JMP inner _
LABEL emit _
ASET out r3,r5
ADD r3 1
ASET out r3,r6
ADD r3 1
JMP outer _
LABEL done _
WRITE out r3
MOV r8 r3
DIV r8 2
RET r8 _
END _ _
