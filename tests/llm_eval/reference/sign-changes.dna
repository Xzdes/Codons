GENE main i32
ARRAY buf 100
READ buf r1
LOAD r2 0
LOAD r3 0
LOAD r4 0
LABEL loop _
MOV r5 r2
LT r5 r1
JZ r5 done
AGET r6 buf,r2
MOV r7 r6
LT r7 0
LOAD r8 0
LT r8 r6
MOV r9 r8
SUB r9 r7
JZ r9 skip
JNZ r4 havelast
MOV r4 r9
JMP skip _
LABEL havelast _
MOV r8 r9
EQ r8 r4
JNZ r8 skip
ADD r3 1
MOV r4 r9
LABEL skip _
ADD r2 1
JMP loop _
LABEL done _
RET r3 _
END _ _
