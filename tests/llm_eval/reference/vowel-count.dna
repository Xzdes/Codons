GENE main i32
SLOAD r1 "hello codons"
SLEN r2 r1
LOAD r3 0
LOAD r4 0
LABEL loop _
MOV r5 r3
LT r5 r2
JZ r5 done
SGET r6 r1,r3
MOV r7 r6
EQ r7 97
JNZ r7 yes
MOV r7 r6
EQ r7 101
JNZ r7 yes
MOV r7 r6
EQ r7 105
JNZ r7 yes
MOV r7 r6
EQ r7 111
JNZ r7 yes
MOV r7 r6
EQ r7 117
JNZ r7 yes
JMP next _
LABEL yes _
ADD r4 1
LABEL next _
ADD r3 1
JMP loop _
LABEL done _
RET r4 _
END _ _
